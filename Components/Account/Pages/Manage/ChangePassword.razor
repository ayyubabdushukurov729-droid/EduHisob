@page "/Account/Manage/ChangePassword"
@layout EduHisob.Components.Layout.MainLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using EduHisob.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger

<PageTitle>Parolni o‘zgartirish — EduHisob</PageTitle>

<section class="workspace">
    <div class="page-heading">
        <div><p class="eyebrow">AKKAUNT</p><h1>Parolni o‘zgartirish</h1><p class="muted">Yangi parol kamida 8 belgidan iborat va kamida bitta raqamli bo‘lsin.</p></div>
    </div>
    <StatusMessage Message="@message" />
    <section class="panel password-panel">
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" role="alert" />
            <label for="Input.OldPassword" class="field-label">Hozirgi parol</label>
            <InputText type="password" @bind-Value="Input.OldPassword" id="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" />
            <label for="Input.NewPassword" class="field-label">Yangi parol</label>
            <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" />
            <label for="Input.ConfirmPassword" class="field-label">Yangi parolni takrorlang</label>
            <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
            <button type="submit" class="btn btn-primary form-submit">Parolni yangilash</button>
        </EditForm>
    </section>
</section>

@code {
    private string? message;
    private ApplicationUser? user;
    private bool hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        hasPassword = await UserManager.HasPasswordAsync(user);
        if (!hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            message = $"Xato: {string.Join(" ", changePasswordResult.Errors.Select(error => error.Code == nameof(IdentityErrorDescriber.PasswordMismatch) ? "Hozirgi parol noto‘g‘ri." : TeamAccessService.TranslateError(error)))}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User changed their password successfully.");

        RedirectManager.RedirectToCurrentPageWithStatus("Parol o‘zgartirildi.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Parolni kiriting.")]
        [DataType(DataType.Password)]
        [Display(Name = "Current password")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Parolni kiriting.")]
        [StringLength(100, ErrorMessage = "Yangi parol kamida {2} belgidan iborat bo‘lsin.", MinimumLength = 8)]
        [DataType(DataType.Password)]
        [Display(Name = "New password")]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm new password")]
        [Compare("NewPassword", ErrorMessage = "Yangi parol va takrori bir xil emas.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
