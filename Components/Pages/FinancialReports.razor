@page "/hisobotlar"
@rendermode InteractiveServer
@implements IAsyncDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = CenterRoles.Finance)]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Text
@using Microsoft.JSInterop
@inject CenterDataService CenterData
@inject IJSRuntime JS

<PageTitle>Moliyaviy hisobotlar — EduHisob</PageTitle>

<section class="workspace">
    <div class="page-heading">
        <div>
            <p class="eyebrow">MOLIYA TAHLILI</p>
            <h1>Hisobotlar</h1>
            <p class="muted">Tanlangan davr uchun daromad, xarajat va to‘lov usullarini kuzating.</p>
        </div>
    </div>
    <div class="report-actions">
        <button type="button" class="btn btn-secondary" @onclick="DownloadCsv">Excel uchun CSV yuklash</button>
        <button type="button" class="btn btn-primary" @onclick="PrintReport">PDF saqlash / chop etish</button>
    </div>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="notice @(isError ? "notice-error" : "notice-success")" role="status">@message</div>
    }
    <div class="filter-bar expense-filters">
        <div>
            <label class="field-label" for="report-from">Boshlanish sanasi</label>
            <input @bind="fromDate" @bind:after="LoadReport" id="report-from" type="date" class="form-control" />
        </div>
        <div>
            <label class="field-label" for="report-to">Tugash sanasi</label>
            <input @bind="toDate" @bind:after="LoadReport" id="report-to" type="date" class="form-control" />
        </div>
        <div>
            <label class="field-label" for="report-branch">Filial</label>
            <select @bind="branchFilter" @bind:after="LoadReport" id="report-branch" class="form-select">
                <option value="">Barcha filiallar</option>
                @foreach (var branch in branches)
                {
                    <option value="@branch.Id">@branch.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="metric-grid finance-metrics">
        <article class="metric-card">
            <span class="metric-label">Jami daromad</span>
            <strong>@incomeTotal.ToString("N0")</strong>
            <span class="metric-caption">so‘m</span>
        </article>
        <article class="metric-card">
            <span class="metric-label">Jami xarajat</span>
            <strong>@expenseTotal.ToString("N0")</strong>
            <span class="metric-caption">so‘m</span>
        </article>
        <article class="metric-card">
            <span class="metric-label">Davr qoldig‘i</span>
            <strong>@((incomeTotal - expenseTotal).ToString("N0"))</strong>
            <span class="metric-caption">daromad minus xarajat, so‘m</span>
        </article>
    </div>

    <section class="panel report-chart-panel">
        <div class="panel-heading">
            <div><p class="eyebrow">DAROMAD VA XARAJAT</p><h2>Oylar bo‘yicha taqqoslash</h2></div>
        </div>
        @if (monthlyTotals.Count == 0)
        {
            <p class="muted">Grafik uchun tanlangan davrda qaydlar yo‘q.</p>
        }
        else
        {
            <div class="monthly-chart" role="img" aria-label="Oylar bo‘yicha daromad va xarajat taqqoslanishi">
                @foreach (var month in monthlyTotals)
                {
                    <div class="monthly-chart-item">
                        <div class="monthly-chart-bars">
                            <span class="monthly-chart-bar income-bar" title="Daromad: @month.Income.ToString("N0") so‘m" style="height: @BarHeight(month.Income)%"></span>
                            <span class="monthly-chart-bar expense-bar" title="Xarajat: @month.Expense.ToString("N0") so‘m" style="height: @BarHeight(month.Expense)%"></span>
                        </div>
                        <span class="monthly-chart-label">@month.Month.ToString("MMM yyyy", CultureInfo.GetCultureInfo("uz-Latn-UZ"))</span>
                    </div>
                }
            </div>
            <div class="chart-legend"><span><i class="income-key"></i>Daromad</span><span><i class="expense-key"></i>Xarajat</span></div>
        }
    </section>

    <div class="workspace-grid branch-grid">
        <section class="panel">
            <div class="panel-heading">
                <div><p class="eyebrow">KUNLIK HARAKAT</p><h2>Kunlar bo‘yicha</h2></div>
            </div>
            @if (dailyTotals.Count == 0)
            {
                <p class="muted">Tanlangan davrda moliya qaydlari yo‘q.</p>
            }
            else
            {
                <div class="table-panel">
                    <table class="data-table">
                        <thead><tr><th>SANA</th><th>DAROMAD</th><th>XARAJAT</th><th>QOLDIQ</th></tr></thead>
                        <tbody>
                            @foreach (var day in dailyTotals)
                            {
                                <tr>
                                    <td>@day.Date.ToString("dd.MM.yyyy")</td>
                                    <td>@day.Income.ToString("N0") so‘m</td>
                                    <td>@day.Expense.ToString("N0") so‘m</td>
                                    <td><strong>@((day.Income - day.Expense).ToString("N0")) so‘m</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="panel">
            <div class="panel-heading">
                <div><p class="eyebrow">KATEGORIYALAR</p><h2>Daromad va xarajat turlari</h2></div>
            </div>
            @if (categoryTotals.Count == 0)
            {
                <p class="muted">Kategoriyalar bo‘yicha ko‘rsatish uchun qayd yo‘q.</p>
            }
            else
            {
                <div class="table-panel">
                    <table class="data-table">
                        <thead><tr><th>TURI</th><th>KATEGORIYA</th><th>QAYDLAR</th><th>JAMI</th></tr></thead>
                        <tbody>
                            @foreach (var category in categoryTotals)
                            {
                                <tr>
                                    <td>@TypeName(category.Type)</td>
                                    <td><strong>@category.Category</strong></td>
                                    <td>@category.Count</td>
                                    <td>@category.Amount.ToString("N0") so‘m</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <section class="panel history-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">XARAJAT NAZORATI</p>
                <h2>Oylik budjetlar</h2>
            </div>
            <div class="month-picker">
                <label class="field-label" for="budget-month">Budjet oyi</label>
                <input @bind="budgetMonth" @bind:after="LoadBudgets" id="budget-month" type="month" class="form-control" />
            </div>
        </div>
        @if (budgetWarnings.Count > 0)
        {
            <div class="notice budget-warning" role="status">
                @foreach (var warning in budgetWarnings)
                {
                    <div>@warning.BranchName · @warning.Category: sarf @warning.SpentAmount.ToString("N0") / @warning.LimitAmount.ToString("N0") so‘m (@warning.PercentUsed.ToString("N0")%)</div>
                }
            </div>
        }
        @if (budgets.Count == 0)
        {
            <p class="muted">Bu oy uchun budjet belgilanmagan.</p>
        }
        else
        {
            <div class="table-panel">
                <table class="data-table">
                    <thead><tr><th>FILIAL</th><th>KATEGORIYA</th><th>LIMIT</th><th>SARFLANDI</th><th>QOLDI</th></tr></thead>
                    <tbody>
                        @foreach (var budget in budgets)
                        {
                            var spent = SpentFor(budget);
                            <tr>
                                <td>@budget.BranchName</td>
                                <td><strong>@budget.Category</strong></td>
                                <td>@budget.LimitAmount.ToString("N0") so‘m</td>
                                <td>@spent.ToString("N0") so‘m</td>
                                <td>@Math.Max(0, budget.LimitAmount - spent).ToString("N0") so‘m</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (branches.Count == 0)
        {
            <p class="muted">Budjet belgilash uchun faol filial kerak.</p>
        }
        else
        {
            <EditForm Model="budgetInput" OnValidSubmit="SaveBudget" FormName="expense-budget">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />
                <div class="budget-form">
                    <div>
                        <label class="field-label" for="budget-branch">Filial</label>
                        <InputSelect @bind-Value="budgetInput.BranchId" id="budget-branch" class="form-select">
                            @foreach (var branch in branches)
                            {
                                <option value="@branch.Id">@branch.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <label class="field-label" for="budget-category">Xarajat kategoriyasi</label>
                        <InputText @bind-Value="budgetInput.Category" id="budget-category" class="form-control" />
                        <ValidationMessage For="() => budgetInput.Category" />
                    </div>
                    <div>
                        <label class="field-label" for="budget-limit">Oylik limit (so‘m)</label>
                        <InputNumber @bind-Value="budgetInput.LimitAmount" id="budget-limit" class="form-control" />
                        <ValidationMessage For="() => budgetInput.LimitAmount" />
                    </div>
                    <button class="btn btn-primary" type="submit">Budjetni saqlash</button>
                </div>
            </EditForm>
        }
    </section>

    <section class="panel history-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">O‘QUVCHI TO‘LOVLARI</p>
                <h2>Qarzdorlik hisoboti</h2>
            </div>
            <div class="month-picker">
                <label class="field-label" for="debt-month">Oxirgi to‘liq oy</label>
                <input @bind="debtMonth" @bind:after="LoadDebts" id="debt-month" type="month" class="form-control" />
            </div>
        </div>
        <p class="muted">Faol o‘quvchi va guruhlar hisoblanadi. Oylik to‘lov amaldagi guruh tarifiga ko‘ra to‘liq oylar uchun jamlanadi va o‘quvchiga bog‘langan tushumlar ayriladi. Tarixiy tarif o‘zgarishlari alohida saqlanmaydi.</p>
        @if (!string.IsNullOrEmpty(debtMessage))
        {
            <div class="notice @(debtIsError ? "notice-error" : "notice-success")" role="status">@debtMessage</div>
        }
        @if (debts.Count == 0)
        {
            <p class="muted">Tanlangan to‘liq oylar bo‘yicha qarzdorlik yo‘q.</p>
        }
        else
        {
            <div class="table-panel">
                <table class="data-table">
                    <thead><tr><th>O‘QUVCHI</th><th>GURUHLAR</th><th>FILIAL</th><th>HISOBLANGAN</th><th>TO‘LANGAN</th><th>QARZ</th></tr></thead>
                    <tbody>
                        @foreach (var debt in debts)
                        {
                            <tr>
                                <td><strong>@debt.StudentName</strong></td>
                                <td>@debt.GroupNames</td>
                                <td>@debt.BranchName</td>
                                <td>@debt.ExpectedAmount.ToString("N0") so‘m</td>
                                <td>@debt.PaidAmount.ToString("N0") so‘m</td>
                                <td><strong>@debt.Balance.ToString("N0") so‘m</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel history-panel">
        <div class="panel-heading">
            <div><p class="eyebrow">TO‘LOV TAQSIMOTI</p><h2>To‘lov usullari bo‘yicha</h2></div>
        </div>
        @if (paymentTotals.Count == 0)
        {
            <p class="muted">Tanlangan davrda to‘lov qaydlari yo‘q.</p>
        }
        else
        {
            <div class="table-panel">
                <table class="data-table">
                    <thead><tr><th>TURI</th><th>TO‘LOV USULI</th><th>QAYDLAR</th><th>JAMI</th></tr></thead>
                    <tbody>
                        @foreach (var payment in paymentTotals)
                        {
                            <tr>
                                <td>@TypeName(payment.Type)</td>
                                <td><strong>@MethodName(payment.Method)</strong></td>
                                <td>@payment.Count</td>
                                <td>@payment.Amount.ToString("N0") so‘m</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <p class="muted">Hisobotda tanlangan davrda qayd etilgan tushum va xarajatlar jamlanadi; ish haqi to‘lovlari xarajatlar tarkibida hisoblangan.</p>
    </section>

    <section class="panel history-panel">
        <div class="panel-heading">
            <div><p class="eyebrow">AUDIT TARIXI</p><h2>Moliyaviy amallar tarixi</h2></div>
        </div>
        <p class="muted">Yangi moliya qaydlari, ish haqi amallari va budjet o‘zgarishlari qayd etiladi.</p>
        @if (auditEntries.Count == 0)
        {
            <p class="muted">Tanlangan davrda audit yozuvi yo‘q.</p>
        }
        else
        {
            <div class="table-panel">
                <table class="data-table">
                    <thead><tr><th>VAQT</th><th>FOYDALANUVCHI</th><th>AMAL</th><th>TAFSILOT</th></tr></thead>
                    <tbody>
                        @foreach (var entry in auditEntries)
                        {
                            <tr>
                                <td>@entry.RecordedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@entry.Actor</td>
                                <td><strong>@entry.Action</strong></td>
                                <td>@entry.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

</section>

@code {
    private readonly BudgetInput budgetInput = new();
    private IReadOnlyList<Branch> branches = [];
    private IReadOnlyList<FinancialTransactionSummary> transactions = [];
    private IReadOnlyList<FinancialTransactionSummary> budgetTransactions = [];
    private IReadOnlyList<ExpenseBudgetSummary> budgets = [];
    private IReadOnlyList<StudentDebtSummary> debts = [];
    private IReadOnlyList<FinancialAuditSummary> auditEntries = [];
    private DateTime fromDate = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime toDate = DateTime.Today;
    private DateTime budgetMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime debtMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-1);
    private string branchFilter = "";
    private string? message;
    private bool isError;
    private string? debtMessage;
    private bool debtIsError;
    private IJSObjectReference? reportsModule;

    private decimal incomeTotal => transactions
        .Where(item => item.Type == FinancialTransactionType.Income)
        .Sum(item => item.Amount);
    private decimal expenseTotal => transactions
        .Where(item => item.Type == FinancialTransactionType.Expense)
        .Sum(item => item.Amount);
    private IReadOnlyList<MonthlyTotal> monthlyTotals => transactions
        .GroupBy(item => new { item.Date.Year, item.Date.Month })
        .Select(group => new MonthlyTotal(
            new DateTime(group.Key.Year, group.Key.Month, 1),
            group.Where(item => item.Type == FinancialTransactionType.Income).Sum(item => item.Amount),
            group.Where(item => item.Type == FinancialTransactionType.Expense).Sum(item => item.Amount)))
        .OrderBy(item => item.Month)
        .ToList();
    private decimal chartMaximum => monthlyTotals.SelectMany(item => new[] { item.Income, item.Expense }).DefaultIfEmpty(0).Max();
    private IReadOnlyList<BudgetWarning> budgetWarnings => budgets
        .Select(budget => new BudgetWarning(budget.BranchName, budget.Category, SpentFor(budget), budget.LimitAmount))
        .Where(item => item.SpentAmount >= item.LimitAmount)
        .ToList();
    private IReadOnlyList<DailyTotal> dailyTotals => transactions
        .GroupBy(item => item.Date)
        .Select(group => new DailyTotal(
            group.Key,
            group.Where(item => item.Type == FinancialTransactionType.Income).Sum(item => item.Amount),
            group.Where(item => item.Type == FinancialTransactionType.Expense).Sum(item => item.Amount)))
        .OrderByDescending(item => item.Date)
        .ToList();
    private IReadOnlyList<CategoryTotal> categoryTotals => transactions
        .GroupBy(item => new { item.Type, item.Category })
        .Select(group => new CategoryTotal(group.Key.Type, group.Key.Category, group.Count(), group.Sum(item => item.Amount)))
        .OrderByDescending(item => item.Amount)
        .ToList();
    private IReadOnlyList<PaymentTotal> paymentTotals => transactions
        .GroupBy(item => new { item.Type, item.PaymentMethod })
        .Select(group => new PaymentTotal(group.Key.Type, group.Key.PaymentMethod, group.Count(), group.Sum(item => item.Amount)))
        .OrderBy(item => item.Type)
        .ThenByDescending(item => item.Amount)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            branches = await CenterData.GetBranchesAsync();
            if (branches.Count > 0)
            {
                budgetInput.BranchId = branches[0].Id;
            }
            await LoadReport();
        }
        catch (Exception exception) when (exception is UnauthorizedAccessException or InvalidOperationException)
        {
            message = exception.Message;
        }
    }

    private async Task LoadReport()
    {
        var from = DateOnly.FromDateTime(fromDate);
        var to = DateOnly.FromDateTime(toDate);
        if (to < from)
        {
            message = "Tugash sanasi boshlanish sanasidan oldin bo‘lmasin.";
            isError = true;
            return;
        }

        try
        {
            int? selectedBranch = int.TryParse(branchFilter, out var parsedBranch) ? parsedBranch : null;
            transactions = await CenterData.GetFinancialTransactionsAsync(from, to, selectedBranch);
            message = null;
            isError = false;
            await LoadBudgets();
            await LoadDebts();
            auditEntries = await CenterData.GetFinancialAuditAsync(from, to);
        }
        catch (Exception exception) when (exception is UnauthorizedAccessException or InvalidOperationException)
        {
            message = exception.Message;
            isError = true;
        }
    }

    private async Task LoadBudgets()
    {
        try
        {
            var month = new DateOnly(budgetMonth.Year, budgetMonth.Month, 1);
            int? selectedBranch = int.TryParse(branchFilter, out var parsedBranch) ? parsedBranch : null;
            budgets = await CenterData.GetExpenseBudgetsAsync(month, selectedBranch);
            budgetTransactions = await CenterData.GetFinancialTransactionsAsync(
                month,
                month.AddMonths(1).AddDays(-1),
                selectedBranch);
        }
        catch (Exception exception) when (exception is UnauthorizedAccessException or InvalidOperationException)
        {
            message = exception.Message;
            isError = true;
        }
    }

    private async Task LoadDebts()
    {
        var throughMonth = new DateOnly(debtMonth.Year, debtMonth.Month, 1).AddMonths(1);
        var currentMonth = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);
        if (throughMonth > currentMonth)
        {
            debts = [];
            debtMessage = "Qarzdorlik faqat to‘liq yakunlangan oylar uchun chiqariladi.";
            debtIsError = false;
            return;
        }

        try
        {
            int? selectedBranch = int.TryParse(branchFilter, out var parsedBranch) ? parsedBranch : null;
            debts = await CenterData.GetStudentDebtReportAsync(throughMonth, selectedBranch);
            debtMessage = null;
        }
        catch (Exception exception) when (exception is UnauthorizedAccessException or InvalidOperationException)
        {
            debtMessage = exception.Message;
            debtIsError = true;
        }
    }

    private decimal SpentFor(ExpenseBudgetSummary budget) => budgetTransactions
        .Where(item =>
            item.Type == FinancialTransactionType.Expense &&
            item.BranchId == budget.BranchId &&
            string.Equals(item.Category, budget.Category, StringComparison.OrdinalIgnoreCase))
        .Sum(item => item.Amount);

    private async Task SaveBudget()
    {
        try
        {
            await CenterData.SaveExpenseBudgetAsync(
                budgetInput.BranchId,
                new DateOnly(budgetMonth.Year, budgetMonth.Month, 1),
                budgetInput.Category,
                budgetInput.LimitAmount);
            await LoadBudgets();
            auditEntries = await CenterData.GetFinancialAuditAsync(
                DateOnly.FromDateTime(fromDate),
                DateOnly.FromDateTime(toDate));
            message = "Oylik budjet saqlandi.";
            isError = false;
        }
        catch (Exception exception) when (exception is UnauthorizedAccessException or InvalidOperationException or Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            message = exception is Microsoft.EntityFrameworkCore.DbUpdateException
                ? "Budjetni saqlab bo‘lmadi."
                : exception.Message;
            isError = true;
        }
    }

    private string BarHeight(decimal amount) =>
        amount <= 0 || chartMaximum <= 0
            ? "0"
            : Math.Max(3, (double)(amount / chartMaximum * 100)).ToString("0.#", CultureInfo.InvariantCulture);

    private async Task DownloadCsv()
    {
        await EnsureReportsModuleAsync();
        await reportsModule!.InvokeVoidAsync("downloadCsv", BuildCsv(), $"EduHisob-hisobot-{DateTime.Today:yyyy-MM-dd}.csv");
    }

    private async Task PrintReport()
    {
        await EnsureReportsModuleAsync();
        await reportsModule!.InvokeVoidAsync("printReport");
    }

    private async Task EnsureReportsModuleAsync()
    {
        reportsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/financial-reports.js");
    }

    private string BuildCsv()
    {
        var csv = new StringBuilder();
        AppendCsvRow(csv, "EduHisob moliyaviy hisoboti", fromDate.ToString("yyyy-MM-dd"), toDate.ToString("yyyy-MM-dd"));
        AppendCsvRow(csv, "Jami daromad", incomeTotal);
        AppendCsvRow(csv, "Jami xarajat", expenseTotal);
        AppendCsvRow(csv, "Davr qoldig‘i", incomeTotal - expenseTotal);
        AppendCsvRow(csv);
        AppendCsvRow(csv, "Moliya qaydlari");
        AppendCsvRow(csv, "Sana", "Turi", "Kategoriya", "O‘quvchi", "Filial", "Summa", "To‘lov usuli", "Izoh");
        foreach (var item in transactions)
        {
            AppendCsvRow(csv, item.Date.ToString("yyyy-MM-dd"), TypeName(item.Type), item.Category, item.StudentName, item.BranchName, item.Amount, MethodName(item.PaymentMethod), item.Note);
        }
        AppendCsvRow(csv);
        AppendCsvRow(csv, "O‘quvchi qarzdorligi");
        AppendCsvRow(csv, "O‘quvchi", "Guruh", "Filial", "Hisoblangan", "To‘langan", "Qarz");
        foreach (var item in debts)
        {
            AppendCsvRow(csv, item.StudentName, item.GroupNames, item.BranchName, item.ExpectedAmount, item.PaidAmount, item.Balance);
        }
        AppendCsvRow(csv);
        AppendCsvRow(csv, "Budjetlar");
        AppendCsvRow(csv, "Oy", "Filial", "Kategoriya", "Limit", "Sarflandi", "Qoldi");
        foreach (var item in budgets)
        {
            var spent = SpentFor(item);
            AppendCsvRow(csv, item.Month.ToString("yyyy-MM"), item.BranchName, item.Category, item.LimitAmount, spent, Math.Max(0, item.LimitAmount - spent));
        }
        AppendCsvRow(csv);
        AppendCsvRow(csv, "Moliyaviy audit");
        AppendCsvRow(csv, "Vaqt (UTC)", "Foydalanuvchi", "Amal", "Tafsilot");
        foreach (var item in auditEntries)
        {
            AppendCsvRow(csv, item.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm:ss"), item.Actor, item.Action, item.Description);
        }
        return csv.ToString();
    }

    private static void AppendCsvRow(StringBuilder csv, params object?[] values)
    {
        csv.AppendLine(string.Join(",", values.Select(value => CsvCell(value switch
        {
            null => "",
            decimal amount => amount.ToString("0.##", CultureInfo.InvariantCulture),
            _ => Convert.ToString(value, CultureInfo.InvariantCulture) ?? ""
        }))));
    }

    private static string CsvCell(string value)
    {
        if (value.Length > 0 && value[0] is '=' or '+' or '-' or '@' or '\t' or '\r')
        {
            value = $"'{value}";
        }

        return $"\"{value.Replace("\"", "\"\"")}\"";
    }

    private static string TypeName(FinancialTransactionType type) =>
        type == FinancialTransactionType.Income ? "Daromad" : "Xarajat";

    private static string MethodName(PaymentMethod method) => method switch
    {
        PaymentMethod.Cash => "Naqd",
        PaymentMethod.Card => "Karta",
        PaymentMethod.Terminal => "Terminal",
        _ => "Bank o‘tkazmasi"
    };

    public async ValueTask DisposeAsync()
    {
        if (reportsModule is not null)
        {
            await reportsModule.DisposeAsync();
        }
    }

    private sealed class BudgetInput
    {
        [Required(ErrorMessage = "Xarajat kategoriyasini kiriting.")]
        [StringLength(120, MinimumLength = 2, ErrorMessage = "Kategoriya 2–120 belgidan iborat bo‘lsin.")]
        public string Category { get; set; } = "";

        [Range(typeof(decimal), "1", "999999999", ErrorMessage = "Limitni 1 va 999 999 999 orasida kiriting.")]
        public decimal LimitAmount { get; set; }

        public int BranchId { get; set; }
    }

    private sealed record MonthlyTotal(DateTime Month, decimal Income, decimal Expense);
    private sealed record BudgetWarning(string BranchName, string Category, decimal SpentAmount, decimal LimitAmount)
    {
        public decimal PercentUsed => LimitAmount == 0 ? 0 : SpentAmount / LimitAmount * 100;
    }

    private sealed record DailyTotal(DateOnly Date, decimal Income, decimal Expense);
    private sealed record CategoryTotal(FinancialTransactionType Type, string Category, int Count, decimal Amount);
    private sealed record PaymentTotal(FinancialTransactionType Type, PaymentMethod Method, int Count, decimal Amount);
}
